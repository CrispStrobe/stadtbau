  "@tileName": {"description": "Display name of a tile type", "placeholders": {"id": {"type": "String"}}},

  "tileDescription": "{id, select, meadow{Extensive grassland. Cheap, decent habitat, cools a little.} cropland{Farmland. Low habitat value, small CO₂ source.} forest{Deciduous forest. Best habitat, absorbs CO₂, dampens noise and dust. Matures over decades.} water{Pond or lake. Good habitat, cools its surroundings.} park{Urban park. Recreation within 300 m, cooling, some habitat.} housing_low{Single-family homes, about 45 residents per hectare.} housing_high{Apartment blocks, about 180 residents per hectare with ground-floor services.} commercial{Offices and shops. Jobs, shopping within walking distance, delivery noise.} industry{Manufacturing. Many jobs, noise, emissions.} road{Main road. Connects housing to jobs; traffic causes noise and pollution.} other{}}",
  "@tileDescription": {"description": "One-line description of a tile type", "placeholders": {"id": {"type": "String"}}},

  "categoryName": "{id, select, nature{Landscape} green_urban{Urban green} residential{Housing} work{Work} infrastructure{Infrastructure} other{Other}}",
